/*
 * Hugsun X88PRO DDR4 V10 (RK3518) Android TV box, sold as "TV98".
 *
 * Linux DT for the Rockchip vendor 6.1 kernel. Based on the RK3518 EVB1
 * DDR4 reference design; every board-specific pin below is taken from the
 * stock Android DT (rk3518_x88pro_ddr4_v10, dumped from /proc/device-tree).
 */

/dts-v1/;

#include "rk3518.dtsi"
#include "rk3518-evb.dtsi"
#include "rk3528-linux.dtsi"

/ {
	model = "Hugsun X88PRO DDR4 V10 (RK3518)";
	compatible = "hugsun,x88pro-ddr4-v10", "rockchip,rk3518", "rockchip,rk3528";

	/* Console comes from armbianEnv.txt (ttyFIQ0); uart2 belongs to Bluetooth. */
	/delete-node/ chosen;

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
		mmc2 = &sdio1;
	};

	/*
	 * The EVB OTG VBUS switch sits on gpio4 PC1, which is the green power
	 * LED on this board. The stock DT feeds the OTG port from vcc5v0_host.
	 */
	/delete-node/ vcc5v0-otg-regulator;

	leds {
		compatible = "gpio-leds";

		led-power-green {
			label = "green:power";
			gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "default-on";
			default-state = "on";
		};

		led-power-red {
			label = "red:power";
			gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-net-green {
			label = "green:net";
			gpios = <&gpio4 RK_PC0 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-net-red {
			label = "red:net";
			gpios = <&gpio4 RK_PB5 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-ir {
			label = "ir";
			gpios = <&gpio4 RK_PB7 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/* WIFI_REG_ON is gpio3 PB2; the stock DT has no 32k clock output for the module. */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		post-power-on-delay-ms = <200>;
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		/* Stock DT leaves this empty so the driver autodetects the SDIO module. */
		wifi_chip_type = "";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_irq>;
		WIFI,host_wake_irq = <&gpio3 RK_PB3 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart2m0_rtsn>;
		pinctrl-1 = <&uart2m0_gpios>;
		BT,reset_gpio = <&gpio3 RK_PC2 GPIO_ACTIVE_HIGH>;
		BT,wake_host_irq = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&vcc5v0_host {
	gpio = <&gpio4 RK_PB4 GPIO_ACTIVE_HIGH>;
};

&vcc5v0_host_en {
	rockchip,pins = <4 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
};

&u2phy_otg {
	/delete-property/ vbus-supply;
	phy-supply = <&vcc5v0_host>;
};

&u2phy_host {
	phy-supply = <&vcc5v0_host>;
};

&gmac0 {
	status = "okay";
};

/* eMMC: the stock DT runs HS200 capped at 50 MHz; HS400 is not used on this board. */
&sdhci {
	/delete-property/ mmc-hs400-1_8v;
	/delete-property/ mmc-hs400-enhanced-strobe;
	mmc-hs200-1_8v;
	fixed-emmc-driver-type = <4>;
	max-frequency = <50000000>;
};

/*
 * SD: the stock DT runs high-speed at 3.3 V only. UHS (inherited from the EVB)
 * makes the card switch to 1.8 V signalling, which fails here with command
 * timeouts, so drop the UHS modes.
 */
&sdmmc {
	/delete-property/ sd-uhs-sdr12;
	/delete-property/ sd-uhs-sdr25;
	/delete-property/ sd-uhs-sdr50;
	/delete-property/ sd-uhs-sdr104;
	status = "okay";
};

&sdio1 {
	max-frequency = <150000000>;
	no-sd;
	no-mmc;
	supports-sdio;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	mmc-pwrseq = <&sdio_pwrseq>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdio1_bus4 &sdio1_cmd &sdio1_clk>;
	sd-uhs-sdr104;
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer &uart2m0_ctsn>;
	status = "okay";
};

